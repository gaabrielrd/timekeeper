rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function isGoogleOwner() {
        return request.auth != null
          && request.auth.uid == userId
          && request.auth.token.firebase.sign_in_provider == 'google.com';
      }

      function hasValidCounterLimit() {
        return !('customCounters' in request.resource.data)
          || request.resource.data.customCounters.size() <= 5;
      }

      allow read, delete: if isGoogleOwner();
      allow create, update: if isGoogleOwner() && hasValidCounterLimit();

      match /data/{documentId} {
        function isAllowedDocument() {
          return documentId == 'settings' || documentId == 'counters';
        }

        function hasValidItems() {
          return documentId != 'counters'
            || (request.resource.data.items is list
              && request.resource.data.items.size() <= 5);
        }

        allow read, delete: if isGoogleOwner() && isAllowedDocument();
        allow create, update: if isGoogleOwner()
          && isAllowedDocument()
          && hasValidItems();
      }
    }
  }
}
