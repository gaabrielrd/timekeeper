rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isGoogleOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isHexColor(value) {
      return value is string
        && value.matches('^#[0-9a-fA-F]{6}$');
    }

    function hasValidUpdatedAt(data) {
      return !('updatedAt' in data) || data.updatedAt is timestamp;
    }

    function hasValidSettingsFields(data) {
      return (!('endHour' in data)
          || (data.endHour is int && data.endHour >= 17 && data.endHour <= 22))
        && (!('endMinutes' in data)
          || (data.endMinutes is int && data.endMinutes in [25, 55]))
        && (!('accentPrimary' in data) || isHexColor(data.accentPrimary))
        && (!('accentSecondary' in data) || isHexColor(data.accentSecondary))
        && (!('backgroundEnabled' in data) || data.backgroundEnabled is bool)
        && (!('backgroundStyle' in data)
          || data.backgroundStyle in [
            'lava',
            'float',
            'glass',
            'rings',
            'aurora',
            'topography',
            'constellation'
          ])
        && (!('backgroundColorA' in data) || isHexColor(data.backgroundColorA))
        && (!('backgroundColorB' in data) || isHexColor(data.backgroundColorB))
        && (!('backgroundSpeed' in data)
          || (data.backgroundSpeed is int
            && data.backgroundSpeed >= 20
            && data.backgroundSpeed <= 100))
        && (!('backgroundIntensity' in data)
          || (data.backgroundIntensity is int
            && data.backgroundIntensity >= 15
            && data.backgroundIntensity <= 100))
        && (!('showCustomCounters' in data) || data.showCustomCounters is bool);
    }

    function hasValidProfileFields(data) {
      return data.keys().hasOnly([
          'displayName',
          'email',
          'photoURL',
          'updatedAt',
          'endHour',
          'endMinutes',
          'accentPrimary',
          'accentSecondary',
          'backgroundEnabled',
          'backgroundStyle',
          'backgroundColorA',
          'backgroundColorB',
          'backgroundSpeed',
          'backgroundIntensity',
          'showCustomCounters',
          'customCounters'
        ])
        && (!('displayName' in data)
          || (data.displayName is string && data.displayName.size() <= 100))
        && (!('email' in data)
          || (data.email is string && data.email.size() <= 320))
        && (!('photoURL' in data)
          || (data.photoURL is string && data.photoURL.size() <= 2048))
        && (!('customCounters' in data)
          || (data.customCounters is list && data.customCounters.size() <= 5))
        && hasValidSettingsFields(data)
        && hasValidUpdatedAt(data);
    }

    function hasValidCounterBase(counter) {
      return counter is map
        && counter.id is string
        && counter.id.size() > 0
        && counter.id.size() <= 100
        && counter.name is string
        && counter.name.size() > 0
        && counter.name.size() <= 50
        && (!('createdAt' in counter)
          || (counter.createdAt is string && counter.createdAt.size() <= 40))
        && (!('color' in counter)
          || counter.color == null
          || isHexColor(counter.color))
        && (!('imageId' in counter)
          || counter.imageId == null
          || (counter.imageId is string
            && counter.imageId.size() > 0
            && counter.imageId.size() <= 100))
        && (!('imageOpacity' in counter)
          || (counter.imageOpacity is number
            && counter.imageOpacity >= 0
            && counter.imageOpacity <= 100))
        && (!('overlayOpacity' in counter)
          || (counter.overlayOpacity is number
            && counter.overlayOpacity >= 0
            && counter.overlayOpacity <= 100));
    }

    function isValidFixedCounter(counter) {
      return counter.keys().hasOnly([
          'id',
          'name',
          'type',
          'startAtMs',
          'endAtMs',
          'color',
          'createdAt',
          'imageId',
          'imageOpacity',
          'overlayOpacity'
        ])
        && (!('type' in counter) || counter.type == 'fixed')
        && counter.startAtMs is int
        && counter.endAtMs is int
        && counter.startAtMs >= 0
        && counter.endAtMs > counter.startAtMs;
    }

    function isValidDayAt(days, index) {
      return days.size() <= index
        ? true
        : days[index] is int && days[index] >= 0 && days[index] <= 6;
    }

    function hasValidDays(days) {
      return days is list
        && days.size() >= 1
        && days.size() <= 7
        && isValidDayAt(days, 0)
        && isValidDayAt(days, 1)
        && isValidDayAt(days, 2)
        && isValidDayAt(days, 3)
        && isValidDayAt(days, 4)
        && isValidDayAt(days, 5)
        && isValidDayAt(days, 6);
    }

    function isValidRecurringCounter(counter) {
      return counter.keys().hasOnly([
          'id',
          'name',
          'type',
          'startTime',
          'endTime',
          'daysOfWeek',
          'color',
          'createdAt',
          'imageId',
          'imageOpacity',
          'overlayOpacity'
        ])
        && counter.type == 'recurring'
        && counter.startTime is string
        && counter.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && counter.endTime is string
        && counter.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && hasValidDays(counter.daysOfWeek);
    }

    function isValidCounter(counter) {
      return hasValidCounterBase(counter)
        && (isValidFixedCounter(counter) || isValidRecurringCounter(counter));
    }

    function isValidCounterAt(items, index) {
      return items.size() <= index ? true : isValidCounter(items[index]);
    }

    function hasValidCounterItems(items) {
      return items is list
        && items.size() <= 5
        && isValidCounterAt(items, 0)
        && isValidCounterAt(items, 1)
        && isValidCounterAt(items, 2)
        && isValidCounterAt(items, 3)
        && isValidCounterAt(items, 4);
    }

    function isValidSettingsDocument(data) {
      return data.keys().hasOnly([
          'endHour',
          'endMinutes',
          'accentPrimary',
          'accentSecondary',
          'backgroundEnabled',
          'backgroundStyle',
          'backgroundColorA',
          'backgroundColorB',
          'backgroundSpeed',
          'backgroundIntensity',
          'showCustomCounters',
          'updatedAt'
        ])
        && hasValidSettingsFields(data)
        && hasValidUpdatedAt(data);
    }

    function isValidCountersDocument(data) {
      return data.keys().hasOnly(['items', 'updatedAt'])
        && hasValidCounterItems(data.items)
        && hasValidUpdatedAt(data);
    }

    function isValidImageItem(image) {
      return image is map
        && image.keys().hasOnly([
          'id',
          'slot',
          'name',
          'size',
          'contentType',
          'createdAt'
        ])
        && image.id is string
        && image.id.size() > 0
        && image.id.size() <= 100
        && image.slot is int
        && image.slot >= 0
        && image.slot <= 9
        && image.name is string
        && image.name.size() > 0
        && image.name.size() <= 120
        && image.size is int
        && image.size > 0
        && image.size <= 5 * 1024 * 1024
        && image.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp',
          'image/gif',
          'image/avif'
        ]
        && image.createdAt is string
        && image.createdAt.size() <= 40;
    }

    function isValidImageAt(items, index) {
      return items.size() <= index ? true : isValidImageItem(items[index]);
    }

    function hasValidImageItems(items) {
      return items is list
        && items.size() <= 10
        && isValidImageAt(items, 0)
        && isValidImageAt(items, 1)
        && isValidImageAt(items, 2)
        && isValidImageAt(items, 3)
        && isValidImageAt(items, 4)
        && isValidImageAt(items, 5)
        && isValidImageAt(items, 6)
        && isValidImageAt(items, 7)
        && isValidImageAt(items, 8)
        && isValidImageAt(items, 9);
    }

    function isValidImagesDocument(data) {
      return data.keys().hasOnly(['items', 'updatedAt'])
        && hasValidImageItems(data.items)
        && hasValidUpdatedAt(data);
    }

    match /users/{userId} {
      allow read, delete: if isGoogleOwner(userId);
      allow create, update: if isGoogleOwner(userId)
        && hasValidProfileFields(request.resource.data);

      match /data/{documentId} {
        function isAllowedDocument() {
          return documentId == 'settings'
            || documentId == 'counters'
            || documentId == 'images';
        }

        function isValidDocument() {
          return (documentId == 'settings'
              && isValidSettingsDocument(request.resource.data))
            || (documentId == 'counters'
              && isValidCountersDocument(request.resource.data))
            || (documentId == 'images'
              && isValidImagesDocument(request.resource.data));
        }

        allow read, delete: if isGoogleOwner(userId) && isAllowedDocument();
        allow create, update: if isGoogleOwner(userId)
          && isAllowedDocument()
          && isValidDocument();
      }
    }
  }
}
