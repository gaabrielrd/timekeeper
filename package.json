{
  "name": "timekeeper",
  "version": "1.0.0",
  "private": true,
  "description": "Dashboard estática de contadores com Firebase Auth e Firestore.",
  "scripts": {
    "check": "npm run check:syntax && npm run test:unit",
    "check:syntax": "node --check public/src/time.js && node --check public/src/firebase.js",
    "test": "npm run test:unit && npm run test:rules",
    "test:unit": "node --test --test-isolation=none tests/unit/time.test.cjs tests/contracts/project.test.cjs",
    "test:rules": "firebase emulators:exec --project demo-timekeeper --only firestore \"node --test --test-isolation=none tests/rules/firestore.test.cjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "firebase": "12.16.0",
    "firebase-tools": "15.24.0"
  },
  "engines": {
    "node": ">=22"
  }
}
