rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isGoogleOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isAllowedImage() {
      return request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp',
          'image/gif',
          'image/avif'
        ];
    }

    // Dez slots de 5 MiB impõem um teto físico de 50 MiB por usuário.
    match /users/{userId}/counter-images/{slot} {
      allow read, delete: if isGoogleOwner(userId)
        && slot.matches('^[0-9]$');
      allow create, update: if isGoogleOwner(userId)
        && slot.matches('^[0-9]$')
        && isAllowedImage();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
